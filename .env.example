# Copy to .env and replace the placeholders. Never commit .env.
DB_PASSWORD=replace-me
# Use the same password above, URL-encoded in this connection URL.
DATABASE_URL=postgresql+psycopg://dealership:replace-me@localhost:5432/dealership
# Set a randomly generated secret of at least 32 characters, e.g. secrets.token_hex(32).
JWT_SECRET=
